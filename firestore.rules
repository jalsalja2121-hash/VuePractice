rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/notes/{noteId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['title', 'content', 'done', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['title', 'content', 'done', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && d.content is string && d.content.size() <= 5000
          && d.done is bool && d.createdAt is timestamp
          && d.updatedAt == request.time;
      }
      allow read, delete: if owner();
      allow create: if owner() && valid() && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid() && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
